  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Want to make the ball hit sand and stop or something like that?

    Use
    a PhysicsMaterial on your floor colliders.


    OpenPutt looks at the dynamicFriction
    value to decide how much friction it should apply to the ball every frame it
    touches that material.


    OpenPutt includes a couple of preset PhysicsMaterials
    in the samples

    (OpenPutt -> Import Samples)














    Please make
    sure to assign the "FloorPhysics" material to your courses to use the recommended
    0.05 friction!'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}

--- !u!114 &6857985920967468751
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7851581950985245551}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'To get around the PhysX issue I talked about on the sign to your right
    ---->>>


    I created a script that will override the friction/drag that gets
    applied to the ball.

    It works by placing the script on a collider that is
    set as "trigger" so the ball can pass through it normally. While the ball is
    inside the collider the friction/drag are overriden so you can simulate having
    a different PhysicsMaterial purely in code.


    This gets around separate meshes
    causing bouncing issues as you can keep it all as one mesh now :)'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
